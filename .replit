modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "API Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/trading-platform run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 21210
externalPort = 80

[userenv]
# Set these to your Deriv app credentials.
# DERIV_APP_ID: your alphanumeric app ID from app.deriv.com/apps (e.g. 33TQEuMW21nTbCZ7Hfb0q)
# VITE_DERIV_APP_ID: same value — exposed to the frontend for the OAuth redirect
# Users authenticate with a Personal Access Token (PAT) from app.deriv.com/account/api-token

[userenv.shared]
DERIV_APP_ID = ""
API_PORT = "8080"
VITE_DERIV_APP_ID = ""

[nix]
channel = "stable-25_05"
